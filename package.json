{
  "name": "vem-pro-ppgi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test functions/test/*.test.js",
    "test:firebase": "firebase emulators:exec --project demo-vem-pro-ppgi --only firestore \"node --test tests/firebase.integration.test.js\"",
    "emulators": "firebase emulators:start --project demo-vem-pro-ppgi --only auth,firestore,functions",
    "dev:emulators": "vite --mode emulator",
    "seed:emulators": "node functions/scripts/seed-emulator.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
