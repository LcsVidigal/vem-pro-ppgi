rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Provas Anteriores do PPGI UFAM (Google Drive catalog)
    match /exams/{examId} {
      allow read, write: if true;
    }

    // 2. Banco de Questões do PPGI UFAM
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // 3. Trilhas de Estudo dos Usuários (US12)
    match /study_tracks/{userId} {
      allow read, write: if true;
    }

    // 4. Regra geral de desenvolvimento
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

